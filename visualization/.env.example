# Directory containing AgentSchool run folders.
AGENTSCHOOL_RUNS_DIR=logs

# AgentSchool itself reads this key. Never commit a real value.
SCHOOLAGENT_API_KEY=replace-with-your-key

# Optional embedding model identifiers or local paths used by AgentSchool.
# BGE_MODEL=BAAI/bge-small-zh-v1.5
# BGE_MODEL_L=BAAI/bge-small-zh-v1.5

# Optional for running the upstream CLI directly; the classroom app enforces English.
AGENTSCHOOL_OUTPUT_LANGUAGE=en
